# ── Docker .env (copy to .env and customize) ───────────────

# Database
DB_PASSWORD=schoolpass123

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me

# Client URL (frontend)
CLIENT_URL=http://localhost:3001
API_URL=http://localhost:3000

# NVIDIA AI (optional, for AI assistant)
NVIDIA_API_KEY=

# SMTP Email (optional, for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@eduplatform.com
SMTP_PASS=your-app-password
EMAIL_FROM=EduPlatform <noreply@eduplatform.com>
